{
  "name": "techomato-orbit",
  "private": true,
  "description": "Techomato Orbit: a free, open-source Windows app to manage local services, databases, logs, ports and PC health.",
  "keywords": [
    "windows",
    "developer-tools",
    "local-development",
    "service-manager",
    "process-manager",
    "postgresql",
    "redis",
    "mongodb",
    "mariadb",
    "tauri",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoushikMallik-developer/techomato-orbit.git"
  },
  "homepage": "https://github.com/KoushikMallik-developer/techomato-orbit#readme",
  "bugs": {
    "url": "https://github.com/KoushikMallik-developer/techomato-orbit/issues"
  },
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "start": "tauri dev",
    "release": "tauri build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@reduxjs/toolkit": "^2",
    "@tanstack/react-query": "^5",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.76.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4"
  }
}
